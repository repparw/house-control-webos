{
  "name": "house-control-webos",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --mode webos --host 127.0.0.1",
    "build": "vite build --mode webos --base=./ && node webos/package.mjs",
    "build:webos": "node --run build",
    "lint": "node webos/lint.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node --test webos/*.test.mjs",
    "test:acceptance": "node webos/acceptance.mjs",
    "test:e2e": "playwright test",
    "check": "node --run lint && node --run typecheck && node --run test && node --run build && node --run test:acceptance && node --run test:e2e"
  },
  "dependencies": {
    "@house-control/visuals": "github:repparw/house-control#4442ea5883529f66ad550ec5bb35a391dd138d30&path:web/packages/visuals",
    "lucide": "0.544.0",
    "qrcode": "1.5.4",
    "three": "0.186.1"
  },
  "devDependencies": {
    "@playwright/test": "1.65.1",
    "typescript": "5.9.3",
    "vite": "8.3.4",
    "ws": "8.23.1"
  },
  "packageManager": "pnpm@10.28.1"
}
